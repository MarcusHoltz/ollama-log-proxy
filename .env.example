# Copy this file to .env and fill in your values. Everything below is
# optional; the compose file has sane defaults. Entries are placeholders
# only, nothing works out of the box.

# Ollama server. Defaults to http://host.docker.internal:11434 (Ollama on
# the same host as Docker). Set for a remote one, e.g. http://192.0.2.30:11434
#OLP_OLLAMA_URL=http://192.0.2.30:11434

# Protect the dashboard and metrics with a token. Empty = open on the LAN.
#OLP_DASHBOARD_TOKEN=
#OLP_METRICS_TOKEN=

# Only needed if you uncomment the UnRAID macvlan / Traefik blocks in
# docker-compose.yml (see README).
#PROXY_IP=192.0.2.50
#DOMAIN=example.com
#SUBDOMAIN=unraid.example.com
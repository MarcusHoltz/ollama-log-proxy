      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (model) (ollama_tokens_total{type=\"prompt\"})",
          "legendFormat": "{{model}} (prompt)",
          "refId": "A"
        },
        {
          "expr": "sum by (model) (ollama_tokens_total{type=\"completion\"})",
          "legendFormat": "{{model}} (completion)",
          "refId": "B"
        }
      ]

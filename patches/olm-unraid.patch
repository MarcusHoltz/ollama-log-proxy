+        def _backend_stats(self) -> dict[str, Any]:
+            stats: dict[str, Any] = {
+                "total_requests": 0,
+                "total_tokens": 0,
+                "models": {},
+                "callers": {},
+            }
+            for entry in backend.query({}):
+                stats["total_requests"] += 1
+                stats["total_tokens"] += entry.total_tokens
+                if entry.caller_ip:
+                    stats["callers"][entry.caller_ip] = (
+                        stats["callers"].get(entry.caller_ip, 0) + 1
+                    )
+                model = stats["models"].setdefault(
+                    entry.model, {"prompt": 0, "completion": 0, "requests": 0}
+                )
+                model["prompt"] += entry.prompt_tokens
+                model["completion"] += entry.completion_tokens
+                model["requests"] += 1
+            return stats
+
+        def _serve_entries(self) -> None:
+            # Return the most recent inference requests with per-request
+            # caller IP, paginated so the dashboard can browse history at
+            # volume (this proxy sees thousands of requests a day).
+            params = parse_qs(urlparse(self.path).query)
+            try:
+                limit = min(200, max(1, int(params.get("limit", ["50"])[0])))
+                offset = max(0, int(params.get("offset", ["0"])[0]))
+            except ValueError:
+                self.send_error(400, "Bad Request")
+                return
+
+            count = getattr(backend, "count", None)
+            total = count({}) if callable(count) else len(backend.query({}))
+            try:
+                page = backend.query({}, limit=limit, offset=offset)
+            except TypeError:
+                page = backend.query({})[offset : offset + limit]
+            payload = {
+                "total": total,
+                "limit": limit,
+                "offset": offset,
+                "entries": [entry.to_dict() for entry in page],
+            }
+            body = json.dumps(payload).encode("utf-8")
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.send_header("Access-Control-Allow-Origin", "*")
+            self.end_headers()
+            self.wfile.write(body)
+

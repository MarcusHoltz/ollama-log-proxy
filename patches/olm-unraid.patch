+    def count(self, filters: dict) -> int:
+        """Count inference logs matching the given filters."""
+        clauses = ["request_type = 'inference'"]
+        params: list = []
+
+        if "since" in filters:
+            clauses.append("timestamp >= ?")
+            params.append(filters["since"])
+        if "model" in filters:
+            clauses.append("model = ?")
+            params.append(filters["model"])
+        if "endpoint" in filters:
+            clauses.append("endpoint = ?")
+            params.append(filters["endpoint"])
+
+        where = " AND ".join(clauses)
+        with self._lock:
+            cursor = self._conn.execute(
+                f"SELECT COUNT(*) FROM inference_logs WHERE {where}", params
+            )
+            return int(cursor.fetchone()[0])
+
+    def aggregate(self, bucket: str = "hour") -> dict:
+        """Return series for the dashboard charts across the full log.
+
+        Bucket is "hour", "day", or "week", applied to the stored UTC
+        timestamp text. Items are the time series, caller counts, per-model
+        average duration, status code counts, and endpoint counts.
+        """
+        bucket_exprs = {
+            "hour": "strftime('%Y-%m-%dT%H:00', timestamp)",
+            "day": "strftime('%Y-%m-%d', timestamp)",
+            "week": "strftime('%G-W%V', timestamp)",
+        }
+        if bucket not in bucket_exprs:
+            raise ValueError(f"unknown bucket: {bucket}")
+        expr = bucket_exprs[bucket]
+
+        with self._lock:
+            cursor = self._conn.execute(
+                f"""SELECT {expr} AS bucket, COUNT(*), SUM(total_tokens),
+                    AVG(duration_ms)
+                FROM inference_logs WHERE request_type = 'inference'
+                GROUP BY bucket ORDER BY bucket"""
+            )
+            time_labels: list[str] = []
+            time_requests: list[int] = []
+            time_tokens: list[int] = []
+            time_duration: list[float] = []
+            for row in cursor.fetchall():
+                time_labels.append(row[0])
+                time_requests.append(row[1])
+                time_tokens.append(row[2] or 0)
+                time_duration.append(round(row[3] or 0, 1))
+
+            cursor = self._conn.execute(
+                """SELECT caller_ip, COUNT(*) FROM inference_logs
+                WHERE request_type = 'inference'
+                GROUP BY caller_ip ORDER BY 2 DESC"""
+            )
+            callers = {row[0]: row[1] for row in cursor.fetchall()}
+
+            cursor = self._conn.execute(
+                """SELECT model, AVG(duration_ms), COUNT(*) FROM inference_logs
+                WHERE request_type = 'inference'
+                GROUP BY model ORDER BY 3 DESC"""
+            )
+            model_rows = cursor.fetchall()
+
+            cursor = self._conn.execute(
+                """SELECT status_code, COUNT(*) FROM inference_logs
+                WHERE request_type = 'inference'
+                GROUP BY status_code ORDER BY 2 DESC"""
+            )
+            status = {str(row[0]): row[1] for row in cursor.fetchall()}
+
+            cursor = self._conn.execute(
+                """SELECT endpoint, COUNT(*) FROM inference_logs
+                WHERE request_type = 'inference'
+                GROUP BY endpoint ORDER BY 2 DESC"""
+            )
+            endpoints = {row[0]: row[1] for row in cursor.fetchall()}
+
+            cursor = self._conn.execute(
+                f"""SELECT caller_ip, {expr} AS bucket, COUNT(*)
+                FROM inference_logs WHERE request_type = 'inference'
+                GROUP BY caller_ip, bucket ORDER BY caller_ip, bucket"""
+            )
+            caller_rows: dict[str, dict[str, int]] = {}
+            for ip, bucket_key, count in cursor.fetchall():
+                caller_rows.setdefault(ip, {})[bucket_key] = count
+
+        top_callers = list(callers)[:15]
+        top_series = {
+            ip: [caller_rows[ip].get(label, 0) for label in time_labels]
+            for ip in top_callers
+        }
+        if len(callers) > len(top_callers):
+            top_series["Other"] = [
+                time_requests[i] - sum(top_series[ip][i] for ip in top_callers)
+                for i in range(len(time_requests))
+            ]
+        return {
+            "bucket": bucket,
+            "time": {
+                "labels": time_labels,
+                "requests": time_requests,
+                "tokens": time_tokens,
+                "avg_duration_ms": time_duration,
+            },
+            "callers": callers,
+            "callers_time": {
+                "labels": time_labels,
+                "series": top_series,
+            },
+            "duration_by_model": {
+                "labels": [row[0] for row in model_rows],
+                "avg_ms": [round(row[1] or 0, 1) for row in model_rows],
+                "counts": [row[2] for row in model_rows],
+            },
+            "status": status,
+            "endpoints": endpoints,
+        }
+
     def close(self) -> None:
